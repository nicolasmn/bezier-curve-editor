{
  "name": "@bezier-curve-editor/core",
  "version": "0.1.0",
  "description": "Bezier curve editor web component built with Lit",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./presets": {
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs",
      "types": "./dist/types/presets/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": ["dist", "custom-elements.json"],
  "sideEffects": ["./dist/index.js", "./dist/index.cjs"],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@bezier-curve-editor/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "lit": "^3.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
