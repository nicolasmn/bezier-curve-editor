{
  "name": "@bezier-curve-editor/core",
  "version": "0.1.0",
  "description": "Bezier curve editor web component built with Lit",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/types/presets/index.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:smoke": "vitest run -c vitest.smoke.config.ts",
    "test:browser": "vitest run -c vitest.config.ts"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@bezier-curve-editor/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^3.2.7",
    "lit": "^3.2.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
